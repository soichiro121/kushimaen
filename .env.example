# ---------------------------------------------------------------------------
# KOMATO RUSH - configuration
#
#   cp .env.example .env
#
# NEVER COMMIT `.env`. It holds the database credentials. `.gitignore` already
# excludes it; this file is the documentation of every key.
#
# On Vercel these are set under Project Settings -> Environment Variables, not
# from a file. The `VITE_*` ones must be present at BUILD time; the rest are read
# at request time by the functions in `api/`.
# ---------------------------------------------------------------------------


# ===========================================================================
# SERVER (secret - never reaches the browser)
# ===========================================================================

# Neon Postgres connection string, from the Neon dashboard.
# Use the POOLED endpoint (the host contains `-pooler`): serverless functions open
# and drop connections constantly, and the unpooled endpoint will run out.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Shared secret for the nightly cleanup route. Generate one and set it in Vercel;
# the cron job sends it as a bearer token. Without it the route answers 404, so an
# unset value fails CLOSED rather than leaving a delete endpoint open.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# `development` includes the exception message in a 500 response. NEVER in production.
# Vercel sets VERCEL_ENV itself, which this falls back to.
# APP_ENV=production

# Timezone that decides what "today" means on the daily leaderboard.
APP_TIMEZONE=Asia/Tokyo

# Fixed-window rate limit, per client, applied to every route except /api/health.
RATE_LIMIT_PER_WINDOW=120
RATE_LIMIT_WINDOW_SECONDS=60

# Largest accepted request body, in bytes.
MAX_BODY_BYTES=32768

# Comma-separated origins allowed to call the API from a DIFFERENT origin.
# Leave EMPTY for the normal deployment, where the game and the API share an
# origin and no CORS headers are needed at all. Never use `*`.
# CORS_ALLOWED_ORIGINS=https://example.com


# ===========================================================================
# FRONTEND (build-time - these are INLINED INTO THE BUNDLE)
#
# Anything below ships to the browser in plain text. Never put a secret here.
# ===========================================================================

# Base URL for the API.
# Leave EMPTY in production: the frontend then calls the same-origin `/api`, which
# removes the CORS surface entirely. Only set this for a split-origin setup.
VITE_API_BASE_URL=

# Title shown on the title screen. Defaults to the one in shared/game-rules.
# VITE_TITLE="KOMATO RUSH"

# Comma-separated stage ids to hide from production without a code change.
# Use this to pull a broken mini-game out of rotation: VITE_DISABLED_STAGES=teacher
VITE_DISABLED_STAGES=

# 1 replaces the whole app with a maintenance screen.
VITE_MAINTENANCE=0

# Global difficulty multiplier (spawn rates, scroll speed). 1 = as designed.
VITE_DIFFICULTY_SCALE=1

# 1 includes /dev and /dev/assets in a PRODUCTION build. Intended for a staging
# URL only - leave it off for the build handed out to players.
VITE_ENABLE_DEV_TOOLS=0

# Where a plain `npm run dev` proxies /api. Only needed if you run the API
# separately; `vercel dev` serves the game and the API on one port and needs none.
VITE_DEV_API_PROXY=http://localhost:3000
