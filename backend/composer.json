{
  "name": "komato/rush-api",
  "description": "KOMATO RUSH score API (Apache + PHP, no Node.js at runtime)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Komato\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Komato\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate.php",
    "serve": "php -S localhost:8080 -t public"
  }
}
