# ---------------------------------------------------------------------------
# KOMATO RUSH - backend configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`: it holds the database password.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# production | development
# `development` returns exception messages in API errors. Never use it in production.
APP_ENV=production

# Timezone used to decide what "today" means on the daily leaderboard.
APP_TIMEZONE=Asia/Tokyo

# Rule-set version to load from shared/game-rules/. Bump only alongside a new vN.json.
CONFIG_VERSION=3

# ---------------------------------------------------------------------------
# Database (PDO). Pick ONE.
# ---------------------------------------------------------------------------

# MySQL / MariaDB - the usual choice on an Apache host
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=komato_rush;charset=utf8mb4"
DB_USER="komato"
DB_PASSWORD="change-me"

# PostgreSQL (including a hosted Postgres such as Supabase)
# DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=komato_rush"
# DB_USER="komato"
# DB_PASSWORD="change-me"

# SQLite - fine for a small single-server deployment and for local development.
# The file MUST live outside the document root and be writable by the web server.
# DB_DSN="sqlite:/var/www/komato-game/shared/komato.sqlite"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where the shared rule set lives. Only needed when `shared/` is not next to `backend/`.
# GAME_RULES_PATH="/var/www/komato-game/shared/game-rules"

# Where to write the JSON-lines log. Must NOT be under the document root.
# LOG_FILE="/var/www/komato-game/backend/var/app.log"

# Mount point when the API is not at the domain root, e.g. "/komato".
# API_BASE_PATH=""

# Rate limiting for POST endpoints. A whole school can share one NAT address, so keep
# this generous; it exists to stop scripts, not classrooms. Set the limit to 0 to disable.
RATE_LIMIT_PER_WINDOW=120
RATE_LIMIT_WINDOW_SECONDS=60

# Set to 1 ONLY when Apache sits behind a proxy/CDN you control, so X-Forwarded-For
# can be trusted. Leave off otherwise: clients can forge that header freely.
TRUSTED_PROXY=0

# Extra origins allowed to call the API. Leave EMPTY in production - the frontend is
# served from the same origin, so no CORS is involved at all.
# CORS_ALLOWED_ORIGINS="http://localhost:5173"
