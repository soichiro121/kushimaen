# Apache configuration for the API document root (backend/public).
#
# Only this directory is exposed over HTTP. `src/`, `vendor/`, `migrations/`,
# `var/` and `.env` live one level up and are therefore unreachable - see
# docs/DEPLOYMENT.md for the matching VirtualHost.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Honour the mount point when the app is not at the domain root.
    RewriteBase /

    # Everything that is not a real file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # The API is JSON-only; never let a browser sniff or frame a response.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always unset X-Powered-By
</IfModule>

# API responses are per-request; nothing here may be cached by a proxy.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# Defence in depth: even if this directory were mis-configured, refuse dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
